/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_RECONSTRUCT3D_DIALOG DIALOGEX 0, 0, 620, 620
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
EXSTYLE WS_EX_APPWINDOW
CAPTION "Binocular Deflectometry 3D Reconstruction"
FONT 9, "Microsoft YaHei UI", 400, 0, 0x86
BEGIN
    LTEXT           "Fringe Image Dir:",IDC_STATIC,12,12,60,10
    EDITTEXT        IDC_EDIT_IMAGE_PATH,80,10,420,12,ES_AUTOHSCROLL | ES_READONLY
    PUSHBUTTON      "Load Images",IDC_BTN_LOAD_IMAGES,510,8,90,14

    LTEXT           "Calibration Dir:",IDC_STATIC,12,32,60,10
    EDITTEXT        IDC_EDIT_CALIB_PATH,80,30,420,12,ES_AUTOHSCROLL | ES_READONLY
    PUSHBUTTON      "Load Calib",IDC_BTN_LOAD_CALIB,510,28,90,14

    LTEXT           "Fringe Pitches:",IDC_STATIC,12,52,60,10
    EDITTEXT        IDC_EDIT_FRINGE_PITCHES,80,50,80,12,ES_AUTOHSCROLL
    LTEXT           "Z min(mm):",IDC_STATIC,180,52,40,10
    EDITTEXT        IDC_EDIT_ZMIN,225,50,50,12,ES_AUTOHSCROLL
    LTEXT           "Z max(mm):",IDC_STATIC,290,52,40,10
    EDITTEXT        IDC_EDIT_ZMAX,335,50,50,12,ES_AUTOHSCROLL

    PUSHBUTTON      "Reconstruct 3D",IDC_BTN_RECONSTRUCT,12,70,90,18
    PUSHBUTTON      "Phase Unwrap",IDC_BTN_PHASE_UNWRAP,110,70,90,18
    PUSHBUTTON      "Save PLY",IDC_BTN_SAVE_POINTCLOUD,208,70,90,18
    CONTROL         "",IDC_PROGRESS_RECON,"msctls_progress32",WS_BORDER,306,72,204,14
    PUSHBUTTON      "Stop",IDC_BTN_CANCEL_RECON,510,70,90,18,WS_DISABLED

    LTEXT           "Ready",IDC_STATIC_STATUS,12,92,500,10

    GROUPBOX        "3D Point Cloud (OpenGL - Drag:Rotate / Wheel:Zoom / RDrag:Pan)",IDC_STATIC,12,108,596,340
    CONTROL         "",IDC_STATIC_POINTCLOUD,"Static",SS_BLACKRECT | WS_BORDER,18,122,584,320

    GROUPBOX        "Log",IDC_STATIC,12,452,596,158
    EDITTEXT        IDC_EDIT_LOG,18,464,584,140,ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL | WS_BORDER
END

